; ==============================================================================
; TallyMind 财务账本主入口 (main.bean)
; ==============================================================================

option "title" "TallyMind 财务账本"
option "operating_currency" "CNY"
option "documents" "documents"

; ------------------------------------------------------------------------------
; 1. 核心插件加载
; ------------------------------------------------------------------------------
plugin "beancount.plugins.auto_accounts"
plugin "beancount_reds_plugins.amortize_over"

; ------------------------------------------------------------------------------
; 2. Fava 可视化大盘扩展 (自动加载同目录下的 dashboards.yaml)
; ------------------------------------------------------------------------------
1970-01-01 custom "fava-extension" "fava_dashboards" "{'config': '/app/dashboards.yaml'}"
1970-01-01 custom "fava-extension" "fava_envelope"
1970-01-01 custom "fava-extension" "fava_portfolio_returns"

; ⭐️ 激活自定义 CSS 主题
1970-01-01 custom "fava-option" "custom-css" "/app/custom.css"

; ------------------------------------------------------------------------------
; 3. 引入子账本
; ------------------------------------------------------------------------------
include "accounts.bean"
include "2026.bean"