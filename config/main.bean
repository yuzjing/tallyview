option "title" "TallyMind 财务账本"
option "operating_currency" "CNY"
option "documents" "documents"

; =============================================================================
; 核心插件与扩展加载
; =============================================================================

; 1. 🌟 Beancount 官方原生自动开户插件 (零第三方依赖，遇到新科目自动免报错开户！)
plugin "beancount.plugins.auto_accounts"

; 2. 🌟 官方大额年费/租金跨月分摊插件 (如健身房年卡均匀平摊 12 个月)
plugin "beancount_reds_plugins.amortize_over"

; 3. 🌟 Fava 官方高信誉前端扩展
custom "fava-extension" "fava_dashboards"          ; ECharts 自定义图表大屏看板
custom "fava-extension" "fava_envelope"            ; YNAB 信封预算法看板
custom "fava-extension" "fava_portfolio_returns"   ; 真实投资收益率 (IRR / TWR)

; =============================================================================
; 引入子账本
; =============================================================================
include "accounts.bean"
include "2026.bean"